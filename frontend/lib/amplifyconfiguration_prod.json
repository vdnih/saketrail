{
  "UserAgent": "aws-amplify-cli/2.0",
  "Version": "1.0",
  "auth": {
    "plugins": {
      "awsCognitoAuthPlugin": {
        "UserAgent": "aws-amplify-cli/2.0",
        "Version": "1.0",
        "IdentityManager": {
          "Default": {}
        },
        "CognitoUserPool": {
          "Default": {
            "PoolId": "ap-northeast-1_saVTZAOph",
            "AppClientId": "3kf0qlluhp4r3hvp3041vpapgh",
            "Region": "ap-northeast-1",
            "username_attributes": ["EMAIL"],
            "standard_required_attributes": ["email"],
            "password_policy": {
              "min_length": 8,
              "require_uppercase": true,
              "require_lowercase": true,
              "require_numbers": true,
              "require_symbols": false
            }
          }
        },
        "Auth": {
          "Default": {
            "authenticationFlowType": "USER_SRP_AUTH"
          }
        },
        "CognitoIdentity": {
          "Default": {
            "PoolId": "ap-northeast-1:f2186063-14c7-4b56-8e35-c803235c9411",
            "Region": "ap-northeast-1"
          }
        }
      }
    }
  }
}
